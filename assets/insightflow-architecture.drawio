        <!-- ============ LEGEND / DESIGN NOTES ============ -->
        <mxCell id="legend" value="Design notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=11;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1500" y="190" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="legendtext" value="• 10-min delay lets Close assign a lead owner before we read it.&#xa;&#xa;• Queue carries a POINTER, not the payload — S3 is the system of record.&#xa;&#xa;• Idempotency is an atomic conditional PutItem, not read-then-write, which would be a TOCTOU race.&#xa;&#xa;• Alert sends BEFORE the ledger records it: a duplicate page beats a missed lead.&#xa;&#xa;• A missing owner is never negative-cached — it goes on a durable worklist that the hourly sweep drains, giving up after 24 tries.&#xa;&#xa;• Bronze object keys are a pure function of the payload, so a webhook retry overwrites itself instead of duplicating.&#xa;&#xa;• Silver/Gold rebuild fully each run; views swap only if every table built." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1512" y="215" width="336" height="320" as="geometry" />
        </mxCell>

